{
  "name": "krakenbot",
  "version": "0.0.0",
  "private": true,
  "description": "Local orchestrator for WormVolt vaults, agent definitions and context handoffs",
  "type": "module",
  "bin": {
    "kraken": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "check": "prettier --check . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "kraken": "node dist/cli/main.js"
  },
  "dependencies": {
    "@wormvolt/core": "file:../WormVolt/packages/core",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
